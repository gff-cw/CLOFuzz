          "if": {
            "properties": {
              "role": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "expected"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "derived"
            ]
          },
