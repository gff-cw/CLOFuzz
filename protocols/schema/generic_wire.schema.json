      "required": [
        "id",
        "direction",
        "weight",
        "example_hex",
        "grammar"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "request"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "correlate"
              ]
            }
          }
        }
      ]
    },
    "correlation": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$(?![\\s\\S])"
