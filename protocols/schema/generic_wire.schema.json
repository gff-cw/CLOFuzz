    },
    "bytes_field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$(?![\\s\\S])"
        },
        "kind": {
          "const": "bytes"
        },
        "role": {
          "enum": [
            "fixed",
            "content"
          ]
        },
        "length": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            {
              "const": "rest"
            },
            {
              "$ref": "#/$defs/length_ref"
            }
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "expected_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{2})*$(?![\\s\\S])",
          "maxLength": 2097152
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "length"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "expected_hex"
            ]
          }
        }
      ]
    },
    "derived": {
      "type": "object",
      "properties": {
        "op": {
          "const": "size_of"
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$(?![\\s\\S])"
            },
            {
              "const": "$message"
            }
          ]
        },
        "add": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "op",
        "target"
      ],
      "additionalProperties": false
    },
    "length_ref": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$(?![\\s\\S])"
        },
        "add": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "grammar": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "struct"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/uint_field"
              },
              {
                "$ref": "#/$defs/bytes_field"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "fields"
      ],
      "additionalProperties": false
