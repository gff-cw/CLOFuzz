{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateafl:generic-wire:online:v1",
  "title": "StateAFL generic-wire v1 online package",
  "description": "Structural authoring contract for the current generic C online loader. This is not a full wire/sequence validator. C loader acceptance is still required. Offline-only migration inventories are deliberately outside this online schema.",
  "$comment": "JSON syntax (unique keys, Unicode validity, integer lexical form), <=1 MiB file bytes, <=65536 native JSON nodes, depth<=96, UTF-8 text byte limits, field uniqueness, reference ordering, bounds relations, example parsing/ambiguity, grammar/framing equations, state count/reachability, correlation type checks, and request/replay budgets require semantic/native checks. uint/bytes wire grammar has a 1 MiB field budget; online frames and examples remain <=65507 bytes. Annotation payloads limitations/unsupported are intentionally opaque because the C loader does not interpret them. Regex end assertions require full string consumption so constrained field identifier/hex patterns cannot stop before terminal line breaks; schema pattern matching is not implicitly a full match.",
  "type": "object",
  "properties": {
    "format": {
      "const": "stateafl.generic-wire"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\u0000]+$(?![\\s\\S])",
      "$comment": "C additionally limits UTF-8 byte length to 63; JSON Schema maxLength counts code points."
    },
    "transport": {
      "enum": [
        "udp",
        "tcp"
      ]
    },
    "online": {
      "const": true,
      "type": "boolean"
    },
    "framing": {
      "oneOf": [
        {
          "$ref": "#/$defs/udp_framing"
        },
        {
          "$ref": "#/$defs/tcp_framing"
        }
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/message"
      },
      "contains": {
        "type": "object",
        "properties": {
          "direction": {
            "const": "request"
          }
        },
        "required": [
          "direction"
        ]
      }
    },
    "states": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[^\\u0000]+$(?![\\s\\S])",
          "$comment": "C additionally limits UTF-8 byte length to 63; JSON Schema maxLength counts code points."
        },
        "transitions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/transition"
          },
          "minItems": 1
        }
      },
      "required": [
        "initial",
        "transitions"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1048576
        }
      },
      "required": [
        "max_messages",
        "max_repeat",
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "limitations": {},
    "unsupported": {}
  },
  "required": [
    "format",
    "version",
    "protocol_id",
    "transport",
    "online",
    "framing",
    "messages",
    "states",
    "limits"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "udp"
          }
        }
      },
      "then": {
        "properties": {
          "framing": {
            "$ref": "#/$defs/udp_framing"
          }
        }
      },
      "else": {
        "properties": {
          "framing": {
            "$ref": "#/$defs/tcp_framing"
          }
        }
      }
    }
  ],
  "$defs": {
