          "const": "uint"
        },
        "role": {
          "enum": [
            "fixed",
            "head",
            "content",
            "derived"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "byte_order": {
          "enum": [
            "big",
            "little"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
