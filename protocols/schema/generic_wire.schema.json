          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "values": {
          "type": "array",
          "maxItems": 32,
