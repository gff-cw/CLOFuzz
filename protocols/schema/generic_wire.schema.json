                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "width": {
                "const": 5
              }
            }
          },
          "then": {
            "properties": {
              "min": {
                "maximum": 1099511627775
              },
              "max": {
                "maximum": 1099511627775
              },
              "expected": {
                "maximum": 1099511627775
              },
              "values": {
                "items": {
                  "maximum": 1099511627775
                }
              }
            }
          }
        },
        {
          "if": {
