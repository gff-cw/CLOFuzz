              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "width": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 65505
              }
            }
          }
        },
        {
          "if": {
