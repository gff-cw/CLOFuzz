{
  "format_version": 1,
  "initial": "connected",
  "invalid_strategy": "one explicitly logged length or semantic transition violation; preserve other dependencies",
  "ir_version": 1,
  "limits": {
    "max_bytes": 1048576,
    "max_messages": 32,
    "max_repeat": 4
  },
  "protocol_id": "ethernet_ip_cip_tcp",
  "states": [
    {
      "id": "connected",
      "meaning": "TCP connected; session unregistered"
    },
    {
      "id": "registering",
      "meaning": "RegisterSession response pending"
    },
    {
      "id": "registered",
      "meaning": "Successful response assigned nonzero session handle; class-3 connection availability is a separate external prerequisite, never implied by this state"
    },
    {
      "id": "closed",
      "meaning": "Session unregistered/transport closed"
    }
  ],
  "transitions": [
    {
      "actions": [],
      "from": "connected",
      "guard": "",
      "message": "register",
      "response": "register_response",
      "to": "registering"
    },
    {
      "actions": [
        "cache peer session handle"
      ],
      "from": "registering",
      "guard": "status=0; version=1; nonzero assigned handle",
      "message": "register_response",
      "response": "",
      "to": "registered"
    },
    {
      "actions": [],
      "from": "registering",
      "guard": "nonzero encapsulation status",
      "message": "register_error",
      "response": "",
      "to": "connected"
    },
    {
      "actions": [],
      "from": "registered",
      "guard": "valid session; cache Sender Context",
      "message": "send_rr",
      "response": "send_rr_response",
      "to": "registered"
    },
    {
      "actions": [],
      "from": "registered",
      "guard": "echoed context, service bit7, general status=0",
      "message": "send_rr_response",
      "response": "",
      "to": "registered"
    },
    {
      "actions": [],
      "from": "registered",
      "guard": "echoed context and nonzero CIP general status",
      "message": "send_rr_error",
      "response": "",
      "to": "registered"
    },
    {
      "actions": [
        "advance externally initialized class-3 UInt16 sequence modulo 65536; cache Sender Context"
      ],
      "from": "registered",
      "guard": "EXTERNAL PRECONDITION: successful ForwardOpen already established an unexpired class-3 explicit connection on this session; use external O->T consumed ID and T->O produced ID",
      "message": "send_unit",
      "response": "send_unit_response",
      "to": "registered"
    },
    {
      "actions": [
        "clear selected connected request context"
      ],
      "from": "registered",
      "guard": "external class-3 connection remains established; produced T->O ID; echoed connected sequence and Sender Context",
      "message": "send_unit_response",
      "response": "",
      "to": "registered"
    },
    {
      "actions": [
        "clear session handle"
      ],
      "from": "registered",
      "guard": "encapsulation status invalid session",
      "message": "invalid_session",
      "response": "",
      "to": "connected"
    },
    {
      "actions": [
        "clear session and connection contexts"
      ],
      "from": "registered",
      "guard": "matching session handle; no reply",
      "message": "unregister",
      "response": "",
      "to": "closed"
    }
  ]
}
