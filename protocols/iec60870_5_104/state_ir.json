{
  "format_version": 1,
  "initial": "stopped",
  "invalid_strategy": "one explicitly logged length or semantic transition violation; preserve other dependencies",
  "ir_version": 1,
  "limits": {
    "max_bytes": 1048576,
    "max_messages": 32,
    "max_repeat": 4
  },
  "protocol_id": "iec60870_5_104",
  "states": [
    {
      "id": "stopped",
      "meaning": "Data transfer stopped"
    },
    {
      "id": "starting",
      "meaning": "STARTDT confirmation pending"
    },
    {
      "id": "active",
      "meaning": "STARTDT confirmed"
    },
    {
      "id": "stopping",
      "meaning": "STOPDT confirmation pending"
    }
  ],
  "transitions": [
    {
      "actions": [],
      "from": "stopped",
      "guard": "TCP connected",
      "message": "start_act",
      "response": "start_con",
      "to": "starting"
    },
    {
      "actions": [],
      "from": "starting",
      "guard": "matching STARTDT",
      "message": "start_con",
      "response": "",
      "to": "active"
    },
    {
      "actions": [],
      "from": "active",
      "guard": "",
      "message": "stop_act",
      "response": "stop_con",
      "to": "stopping"
    },
    {
      "actions": [],
      "from": "stopping",
      "guard": "",
      "message": "stop_con",
      "response": "",
      "to": "stopped"
    },
    {
      "actions": [
        "cache send sequence"
      ],
      "from": "active",
      "guard": "increment N(S) modulo 32768",
      "message": "interrogation",
      "response": "",
      "to": "active"
    },
    {
      "actions": [],
      "from": "active",
      "guard": "acknowledge received I frames",
      "message": "s_ack",
      "response": "",
      "to": "active"
    },
    {
      "actions": [],
      "from": "active",
      "guard": "TESTFR keepalive",
      "message": "test_act",
      "response": "",
      "to": "active"
    },
    {
      "actions": [],
      "from": "active",
      "guard": "TESTFR keepalive",
      "message": "test_con",
      "response": "",
      "to": "active"
    },
    {
      "actions": [],
      "from": "stopped",
      "guard": "TESTFR is independent of data-transfer activation",
      "message": "test_act",
      "response": "test_con",
      "to": "stopped"
    },
    {
      "actions": [],
      "from": "stopped",
      "guard": "TESTFR is independent of data-transfer activation",
      "message": "test_con",
      "response": "",
      "to": "stopped"
    }
  ]
}
